{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpro.local/contracts/reliability-handoff/v1/team-code.handoff-ack.schema.json",
  "title": "team-code/handoff-ack/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_sha256",
    "team_qa_handoff_sha256",
    "team_qa_handoff_integrity",
    "run_uuid",
    "task_base",
    "source_revision",
    "exact_final_sha",
    "requirements_hash",
    "capsule_digest",
    "receiver",
    "received_at",
    "verified_at",
    "handoff_latency_ms",
    "execution_status",
    "semantic_verdict",
    "integrity"
  ],
  "properties": {
    "schema": { "const": "team-code/handoff-ack/v1" },
    "contract_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "team_qa_handoff_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "team_qa_handoff_integrity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "run_uuid": { "type": "string", "minLength": 1 },
    "task_base": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "source_revision": { "type": "string", "minLength": 1 },
    "exact_final_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "requirements_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "capsule_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "version", "source_commit"],
      "properties": {
        "skill": { "const": "team-code" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "received_at": { "type": "string", "format": "date-time" },
    "verified_at": { "type": "string", "format": "date-time" },
    "handoff_latency_ms": { "type": "integer", "minimum": 0 },
    "execution_status": { "const": "completed" },
    "semantic_verdict": { "const": "PASS" },
    "integrity": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
