{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentpro-tech/team-qa/schemas/case-v2.json",
  "title": "Team QA tracked plan v2 with source traceability",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceItems", "cases"],
  "properties": {
    "schemaVersion": {"const": 2},
    "sourceItems": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceItem"}
    },
    "cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/case"}
    },
    "coverage": {"$ref": "#/$defs/coverage"}
  },
  "$defs": {
    "sourceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "sourceSystem", "externalKey", "title", "origin"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "sourceSystem": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "externalKey": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https?://"},
        "origin": {"enum": ["upstream", "qa-derived"]},
        "qaDerivedReason": {"type": "string", "minLength": 1}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "req_id", "sourceRefs", "lane", "steps", "expected", "data",
        "priority", "kind", "taxonomy", "states", "viewports"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "req_id": {"type": "string", "minLength": 1},
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "lane": {"type": "string", "minLength": 1},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "expected": {"type": "string", "minLength": 1},
        "data": {"type": "object"},
        "priority": {"enum": ["P0", "P1", "P2"]},
        "kind": {"enum": ["behavioral", "static"]},
        "taxonomy": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "functional", "boundary", "negative", "state", "regression",
              "visual", "accessibility", "performance", "security"
            ]
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "$comment": "one-row and many-rows are valid only with the root coverage block (R1b).",
          "items": {"enum": ["empty", "loading", "partial", "ideal", "error", "one-row", "many-rows"]}
        },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["mobile", "tablet", "desktop"]}
        },
        "route": {"$comment": "R1b, only with the root coverage block: the case declares cells on this route (a URL path, a route pattern or an overlay node id).", "type": "string", "pattern": "^[^\\s|][^|]{0,511}$"},
        "actions": {"$comment": "R1b, with route; default [\"view\"].", "type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[^\\s|][^|]{0,255}$"}},
        "conditions": {"$comment": "R1b, with route; default [\"*\"] (any). \"default\" or sorted kind=value pairs joined by +.", "type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "coverage": {
      "$comment": "R1b coverage cells block (references/coverage-cells.md).",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "rows"],
      "properties": {
        "version": {"const": "team-qa/coverage-cells/v1"},
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "size", "classes"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
              "size": {"type": "string", "pattern": "^\\d+x\\d+$"},
              "classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["mobile", "tablet", "desktop"]}}
            }
          }
        },
        "staticRoutes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "dataScreens": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
