{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentpro-tech/team-qa/schemas/web-handoff.json",
  "title": "team-qa/handoff/web-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_sha256",
    "run_uuid",
    "requirements_hash",
    "target_kind",
    "target_binding_sha256",
    "target",
    "team_qa_receipt_sha256",
    "team_qa_receipt_integrity",
    "release_verdict",
    "producer",
    "ready_at",
    "integrity"
  ],
  "properties": {
    "schema": {
      "const": "team-qa/handoff/web-v1"
    },
    "contract_sha256": {
      "const": "2ce5542e4f1a7feff66082a34da1ca59d8c223eb97b12ac3a0f70a2c2a5a709f"
    },
    "run_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "requirements_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_kind": {
      "const": "deployed-build"
    },
    "target_binding_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target": {
      "$ref": "deployed-target.json"
    },
    "team_qa_receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "team_qa_receipt_integrity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "release_verdict": {
      "enum": [
        "GO",
        "NO-GO",
        "UNGRADED"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill",
        "version",
        "source_commit"
      ],
      "properties": {
        "skill": {
          "const": "team-qa"
        },
        "version": {
          "type": "string"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "ready_at": {
      "type": "string",
      "format": "date-time"
    },
    "integrity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
