{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Team QA authentic composition child receipt index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "composition_sha256",
    "children"
  ],
  "properties": {
    "schema": {
      "const": "team-qa/composition-children/v1"
    },
    "composition_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "children": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "receipt"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "receipt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
