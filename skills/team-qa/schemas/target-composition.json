{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Team QA explicit parent and target composition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "parent",
    "targets",
    "case_targets"
  ],
  "properties": {
    "schema": {
      "const": "team-qa/target-composition/v1"
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan",
        "tracked",
        "signed_approval"
      ],
      "properties": {
        "plan": {
          "$ref": "#/$defs/pin"
        },
        "tracked": {
          "$ref": "#/$defs/pin"
        },
        "signed_approval": {
          "$ref": "#/$defs/pin"
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "case_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "target_ids"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "target_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "app_values",
        "run_id",
        "run_uuid",
        "task_base",
        "exact_final_sha",
        "requirements_hash",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "app_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "run_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "task_base": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "exact_final_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "requirements_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_id",
            "preview_url",
            "version"
          ],
          "properties": {
            "project_id": {
              "type": "string",
              "minLength": 1
            },
            "preview_url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
