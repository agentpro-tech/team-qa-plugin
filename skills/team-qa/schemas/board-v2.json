{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentpro-tech/team-qa/schemas/board-record-v2.json",
  "title": "Team QA board record v2 with source traceability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "lane", "verdict", "evidence", "source", "run_id", "ts",
    "function_verdict", "ui_visual_verdict", "attempt", "started_at", "ended_at", "timeout_ms",
    "traceabilityVersion", "sourceRefs"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "lane": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["pending", "pass", "fail", "ungraded", "blocked"]},
    "function_verdict": {"enum": ["pass", "fail", "ungraded"]},
    "ui_visual_verdict": {"enum": ["pass", "fail", "ungraded"]},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source": {"enum": ["qa-gui", "qa-code", "script"]},
    "run_id": {"type": "string", "minLength": 1},
    "ts": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "traceabilityVersion": {"const": "team-qa/source-traceability/v1"},
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "task_base": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "source_revision": {"type": "string", "minLength": 1},
    "verification_lane": {"enum": ["code", "gui", "machine", "multi"]},
    "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exact_final_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "attempt_id": {"description": "Unique ID of the attempt. Old records may lack it; Team QA then derives case_id#attempt if it is not a duplicate.", "type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "parent_attempt_id": {"description": "attempt_id of the attempt right before; an old record without attempt_id uses the derived ID case_id#attempt. The first attempt has no parent.", "type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "ended_at": {"type": "string", "minLength": 1},
    "timeout_ms": {"type": "integer", "minimum": 1},
    "target": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["project_id", "preview_url", "version"], "properties": {
          "project_id": {"type": "string", "minLength": 1}, "preview_url": {"type": "string", "minLength": 1, "pattern": "^https?://"}, "version": {"type": "string", "minLength": 1}
        }},
        {"$ref": "deployed-target.json"}
      ]
    },
    "target_kind": {"const": "deployed-build"},
    "target_binding_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "failure_class": {"enum": ["product", "harness", "environment"]},
    "child_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "verdict", "artifact", "sha256"],
      "properties": {
        "skill": {"enum": ["qa-gui", "qa-code"]},
        "verdict": {"enum": ["pass", "fail", "ungraded"]},
        "artifact": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
