{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentpro-tech/team-qa/schemas/plan-v1.json",
  "title": "Team QA plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "app", "plan_version", "lanes", "tiers", "exit_criteria"],
  "properties": {
    "coverage": {
      "$comment": "R1b: the N/A coverage cells the owner signs with the plan (references/coverage-cells.md).",
      "type": "object", "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {"const": "team-qa/coverage-cells/v1"},
        "destructive": {"$comment": "R1e: destructive actions the explorer may press.", "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["route", "action", "reason"],
          "properties": {"route":{"type":"string","minLength":1},"action":{"type":"string","minLength":1},"reason":{"type":"string","minLength":1}}
        }},
        "na": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["route", "reason"],
          "properties": {"route":{"type":"string","minLength":1},"state":{"type":"string"},"action":{"type":"string"},"viewport":{"type":"string"},"condition":{"type":"string"},"reason":{"type":"string","minLength":1}}
        }}
      }
    },
    "preflight": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "gui", "recording"],
      "properties": {"code":{"type":"boolean"},"gui":{"type":"boolean"},"recording":{"type":"boolean"}}
    },
    "speed": {
      "$comment": "Upgrade R3 speed flags (references/speed-flags.md). Optional; every flag is off unless set here, in the signed plan.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "vision_by_diff": {"enum": ["off", "shadow", "on"]},
        "cost_ladder": {"enum": ["off", "shadow", "on"]},
        "parallel_gui_lanes": {"enum": ["off", "shadow", "on"]},
        "fast_click": {"enum": ["off", "shadow", "on"]},
        "action_cache": {"enum": ["off", "shadow", "on"]},
        "min_tier": {"type": "object", "additionalProperties": false,
          "properties": {"gate0": {"enum": [0, 1, 2, 3]}, "vision": {"enum": [0, 1, 2, 3]}, "function": {"enum": [0, 1, 2, 3]}, "verdict": {"enum": [0, 1, 2, 3]}}},
        "baseline_store": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"],
          "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
        "action_cache_store": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"],
          "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
      }
    },
    "run_id": {"type": "string", "minLength": 1},
    "app": {"type": "string", "minLength": 1},
    "plan_version": {"type": "integer", "minimum": 1},
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "parallel_ok", "vi_sao"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "parallel_ok": {"type": "boolean"},
          "vi_sao": {"type": "string"},
          "account": {"type": "string", "minLength": 1, "$comment": "R3: the lane's own test account or tenant (an id, never a password)"},
          "data_namespace": {"type": "string", "minLength": 1, "$comment": "R3: the data namespace only this lane writes"},
          "dragon_session": {"type": "string", "minLength": 1, "$comment": "R3: the prefix of the Dragon sessionId this lane's executor creates"}
        }
      }
    },
    "tiers": {"type": "object", "additionalProperties": {"enum": ["FULL", "SMOKE"]}},
    "exit_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p0_max", "p1_max", "p1_waivers", "coverage_high_pct", "coverage_low_pct"],
      "properties": {
        "p0_max": {"type": "integer", "minimum": 0},
        "p1_max": {"type": "integer", "minimum": 0},
        "p1_waivers": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "coverage_high_pct": {"type": "integer", "minimum": 0, "maximum": 100},
        "coverage_low_pct": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    }
  }
}
